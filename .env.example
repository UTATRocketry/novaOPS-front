# Nova GCS frontend environment
# Backend REST + WebSocket base URLs (see FRONTEND_API_GUIDE.md).
# When frontend and backend share a host, these can be left unset and
# derived from window.location at runtime.
NEXT_PUBLIC_NOVA_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_NOVA_WS_BASE_URL=ws://localhost:8000

# Dev-only: feed a fake signal-strength value through the signal adapter
# until the backend exposes a real field. Set to "1" to enable.
NEXT_PUBLIC_NOVA_FAKE_SIGNAL=0
